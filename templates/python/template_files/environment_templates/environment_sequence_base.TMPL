{% set fname = "{{vip_location}}/{{environment_location}}/{{name}}_env_pkg/{{src_dir}}{{name}}_env_sequence_base.sv" %}
{% extends "base_template.TMPL" %}

{% block description %}
//----------------------------------------------------------------------

// DESCRIPTION: This file contains environment level sequences that will
//    be reused from block to top level simulations.

//----------------------------------------------------------------------
{% endblock %}

{% block contents %}
class {{name}}_env_sequence_base #(
  type CONFIG_T{% for param in paramDefs %},
  {{param.type}} {{param.name}}{% if param.value != None %} = {{param.value}}{% endif %}{% endfor %},
  type ENV_T = uvm_env
) extends uvmf_virtual_sequence_base #(
  .CONFIG_T(CONFIG_T),
  .ENV_T   (ENV_T)
);

  `uvm_object_param_utils({{name}}_env_sequence_base#(CONFIG_T{% for param in paramDefs %}, {{param.name}}{% endfor %}, ENV_T))

  typedef {{name}}_virtual_sequencer #(
    .CONFIG_T(CONFIG_T){% for param in paramDefs %},
    .{{param.name}}({{param.name}}){% endfor %}{{ "\n  " -}}
) virtual_sequencer_t;
  `uvm_declare_p_sequencer(virtual_sequencer_t)

{% for regModel in regModels %}
  // Handle to the environments register model
  // This handle needs to be set before use.
  {{regModel.regBlockClass}} {{regModel.regBlockInstance}};
{% endfor %}

  // This {{name}}_env_sequence_base contains a handle to a {{name}}_env_configuration object
  // named configuration.  This configuration variable contains a handle to each
  // sequencer within each agent within this environment and any sub-environments.
  // The configuration object handle is automatically assigned in the pre_start in the
  // base class of this sequence.  The configuration handle is retrieved from the
  // virtual sequencer that this sequence is started on.
  // Available sequencer handles within the environment configuration:

  // Initiator agent sequencers in {{name}}_environment:
{% for agent in agents %}
{% if agent.initResp == "INITIATOR" %}
    // env.{{agent.name}}.sequencer
    // p_sequencer.{{agent.name}}_sequencer
{% endif %}
{% endfor %}

  // Responder agent sequencers in {{name}}_environment:
{% for agent in agents %}
{% if agent.initResp == "RESPONDER" %}
    // env.{{agent.name}}.sequencer
    // p_sequencer.{{agent.name}}_sequencer
{% endif %}
{% endfor %}

{% if subEnvironments|length > 0 %}
  // Virtual sequencers in sub-environments located in sub-environment configuration
{% for sub_env in subEnvironments %}
    // env.{{sub_env.name}}.vsqr
    // p_sequencer.{{sub_env.name}}_sequencer
{% endfor %}
{% endif %}

  // pragma uvmf custom class_item_additional begin
  // pragma uvmf custom class_item_additional end

  function new(string name = "");
    super.new(name);

    // pragma uvmf custom new_additional begin
    // pragma uvmf custom new_additional end
  endfunction : new

  virtual task body();

    // pragma uvmf custom body begin
    // pragma uvmf custom body end

  endtask : body

  // pragma uvmf custom body_before begin
  // pragma uvmf custom body_before end

  // pragma uvmf custom body_end begin
  // pragma uvmf custom body_end end

endclass : {{name}}_env_sequence_base

// pragma uvmf custom external begin
// pragma uvmf custom external end

{% endblock %}
