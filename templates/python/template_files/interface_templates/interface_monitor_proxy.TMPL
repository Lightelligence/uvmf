{% set fname = "{{vip_location}}/{{interface_location}}/{{name}}_pkg/{{src_dir}}{{name}}_monitor_proxy.sv" %}
{% extends "base_template.TMPL" %}
{% set conditional = "dpi_link" %}
{% block description %}
// DPI transport adapter for the generated monitor API.
{% endblock %}
{% block contents %}
typedef class {{name}}_monitor;

// pragma uvmf custom description begin
// pragma uvmf custom description end

// One nonparameterized callback base is kept here with its derived proxy so the
// fixed C ABI can dispatch to any parameter specialization without a default cast.
virtual class {{name}}_monitor_proxy_base extends dpi_link_proxy;
  protected function new(string name = "");
    super.new(name);
  endfunction
  pure virtual function void notify_transaction_bit_vec(input c_bit_array_t bit_vec_in);
endclass

// Retain UVMF public type, macro and C symbol names for existing DPI integrations.
class {{name}}_monitor_proxy {{macro.paramDeclare(paramDefs)|indent(2)}}
    extends {{name}}_monitor_proxy_base;
{{macro.objUtils([name, '_monitor_proxy']|join(''), paramDefs)}}
  {{name}}_monitor{{macro.paramUse(paramDefs)|indent(4)}} {{name}}_monitor_h;
{% if useStructBfm %}
  `{{name}}_MONITOR_STRUCT
{% endif %}

  // pragma uvmf custom class_item_additional begin
  // pragma uvmf custom class_item_additional end

  function new(string name = "{{name}}_monitor_proxy");
    super.new(name);
    C_initialize_monitor(get_xrtl_path());
  endfunction

  `dpi_link_proxy_get({{name}}_monitor_proxy{{macro.paramUse(paramDefs)|indent(4)}})

  function void configure(uvmf_active_passive_t act_pass,
      uvmf_initiator_responder_t init_resp{% for config in configVars %},
      {{config.type}} {{config.name}} {{config.unpackedDim}}{% endfor %});
    c_bit_array_t bit_vec;
    bit_vec = {act_pass, init_resp{% for config in configVars %}, {{config.name}}{% endfor %}};
    C_configure(get_xrtl_path(), bit_vec);
  endfunction

  function void start_monitoring();
    C_start_monitoring(get_xrtl_path());
  endfunction

  task wait_for_reset();
    C_wait_for_reset(get_xrtl_path());
  endtask

  task wait_for_num_clocks(int clocks);
    c_bit_array_t bit_vec;
    bit_vec = clocks;
    C_wait_for_num_clocks(get_xrtl_path(), bit_vec);
  endtask

  virtual function void notify_transaction_bit_vec(input c_bit_array_t bit_vec_in);
{% if useStructBfm %}
    {{name}}_monitor_s monitored;
    monitored = bit_vec_in;
    {{name}}_monitor_h.notify_transaction(monitored);
{% else %}
    {{name}}_transaction{{macro.paramUse(paramDefs)|indent(4)}} monitored;
    monitored = {{name}}_transaction{{macro.paramUse(paramDefs)|indent(4)}}::type_id::create("monitored");
    { {% for txn in transVars %}monitored.{{txn.name}}{{macro.commalist(loop)}}{% endfor %} } = bit_vec_in;
    {{name}}_monitor_h.notify_transaction(monitored);
{% endif %}
  endfunction
endclass

// pragma uvmf custom external begin
// pragma uvmf custom external end
{% endblock %}
