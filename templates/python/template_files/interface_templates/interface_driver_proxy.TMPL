{% set fname = "{{vip_location}}/{{interface_location}}/{{name}}_pkg/{{src_dir}}{{name}}_driver_proxy.sv" %}
{% extends "base_template.TMPL" %}
{% set conditional = "dpi_link" %}
{% block description %}
// DPI transport adapter for the generated driver and streaming driver APIs.
{% endblock %}
{% block contents %}
// pragma uvmf custom description begin
// pragma uvmf custom description end

// Retain UVMF public type, macro and C symbol names for existing DPI integrations.
class {{name}}_driver_proxy {{macro.paramDeclare(paramDefs)|indent(2)}} extends dpi_link_proxy;
{{macro.objUtils([name, '_driver_proxy']|join(''), paramDefs)}}
{% if useStructBfm %}
  `{{name}}_INITIATOR_STRUCT
  `{{name}}_RESPONDER_STRUCT
{% endif %}

  // pragma uvmf custom class_item_additional begin
  // pragma uvmf custom class_item_additional end

  function new(string name = "xrtl_path");
    super.new(name);
  endfunction

  `dpi_link_proxy_get({{name}}_driver_proxy{{macro.paramUse(paramDefs)|indent(4)}})

  function void configure(uvmf_active_passive_t act_pass,
      uvmf_initiator_responder_t init_resp{% for config in configVars %},
      {{config.type}} {{config.name}} {{config.unpackedDim}}{% endfor %});
    c_bit_array_t bit_vec;
    bit_vec = {act_pass, init_resp{% for config in configVars %}, {{config.name}}{% endfor %}};
    C_configure(get_xrtl_path(), bit_vec);
  endfunction

{% if useStructBfm %}
  task initiate_and_get_response(input {{name}}_initiator_s initiator,
      output {{name}}_responder_s responder);
    c_bit_array_t bit_vec;
    bit_vec = initiator;
    C_access(get_xrtl_path(), bit_vec);
    responder = bit_vec;
  endtask

  task respond_and_wait_for_next_transfer(output {{name}}_initiator_s initiator,
      input {{name}}_responder_s responder);
    c_bit_array_t bit_vec;
    bit_vec = responder;
    C_response(get_xrtl_path(), bit_vec);
    initiator = bit_vec;
  endtask
{% else %}
  task initiate_and_get_response({{name}}_transaction{{macro.paramUse(paramDefs)|indent(4)}} txn);
    c_bit_array_t bit_vec;
    bit_vec = { {% for txn in transVars %}txn.{{txn.name}}{{macro.commalist(loop)}}{% endfor %} };
    C_access(get_xrtl_path(), bit_vec);
    { {% for txn in transVars %}txn.{{txn.name}}{{macro.commalist(loop)}}{% endfor %} } = bit_vec;
  endtask

  task respond_and_wait_for_next_transfer({{name}}_transaction{{macro.paramUse(paramDefs)|indent(4)}} txn);
    c_bit_array_t bit_vec;
    bit_vec = { {% for txn in transVars %}txn.{{txn.name}}{{macro.commalist(loop)}}{% endfor %} };
    C_response(get_xrtl_path(), bit_vec);
    { {% for txn in transVars %}txn.{{txn.name}}{{macro.commalist(loop)}}{% endfor %} } = bit_vec;
  endtask
{% endif %}

{% for method in ['access', 'response'] %}
  task {{method}}({% if useStructBfm %}{% for txn in transVars %}
      inout {{txn.type}} {{txn.name}} {{txn.unpackedDim}}{{macro.commalist(loop)}}{% endfor %}
{% else %}{{name}}_transaction{{macro.paramUse(paramDefs)|indent(4)}} txn{% endif %});
    c_bit_array_t bit_vec;
    bit_vec = { {% for txn in transVars %}{% if not useStructBfm %}txn.{% endif %}{{txn.name}}{{macro.commalist(loop)}}{% endfor %} };
    C_{{method}}(get_xrtl_path(), bit_vec);
    { {% for txn in transVars %}{% if not useStructBfm %}txn.{% endif %}{{txn.name}}{{macro.commalist(loop)}}{% endfor %} } = bit_vec;
  endtask
{% endfor %}

  function void do_response_ready({% for txn in responseList %}
      input {{txn.type}} {{txn.name}} {{txn.unpackedDim}}{{macro.commalist(loop)}}{% endfor %});
    c_bit_array_t bit_vec = '0;
{% if responseList|length > 0 %}
    bit_vec = { {% for txn in responseList %}{{txn.name}}{{macro.commalist(loop)}}{% endfor %} };
{% endif %}
    C_do_response_ready(get_xrtl_path(), bit_vec);
  endfunction
endclass

// pragma uvmf custom external begin
// pragma uvmf custom external end
{% endblock %}
